# Local offline mode works without this file or a provider key.
# For AI mode export these variables before starting Django.
OPENAI_API_KEY=
OPENAI_MODEL=
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-synthetic-demo-only-do-not-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Used by Docker Compose only; change for any shared environment.
POSTGRES_PASSWORD=local-synthetic-demo
